<?xml version="1.0"?>
<robot name="serial_chain">
  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </collision>
  </link>
  <link name="link1">
    <collision>
      <origin xyz="0 0 0.15" rpy="0.1 -0.2 0.3"/>
      <geometry><box size="0.06 0.06 0.3"/></geometry>
    </collision>
  </link>
  <link name="link2">
    <collision>
      <origin xyz="0.1 0 0" rpy="0.0 0.4 -0.1"/>
      <geometry><box size="0.2 0.05 0.05"/></geometry>
    </collision>
  </link>
  <link name="link3">
    <collision>
      <origin xyz="0 0.05 0" rpy="-0.3 0.2 0.5"/>
      <geometry><box size="0.04 0.1 0.04"/></geometry>
    </collision>
  </link>
  <link name="link4">
    <collision>
      <origin xyz="0 0 0.02" rpy="0.2 0.1 -0.4"/>
      <geometry><box size="0.03 0.03 0.1"/></geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0.01 0.02 0.1" rpy="0.1 0.2 0.3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="50" velocity="2"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.03 0 0.3" rpy="-0.2 0.3 0.4"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.8" effort="50" velocity="2"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.2 0.01 0" rpy="0.5 -0.1 0.2"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.0" upper="3.0" effort="20" velocity="3"/>
  </joint>
  <joint name="joint4" type="prismatic">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0.1 0.01" rpy="0.3 0.2 -0.5"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.15" effort="20" velocity="0.5"/>
  </joint>
</robot>
