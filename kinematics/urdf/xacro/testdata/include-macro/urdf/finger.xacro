<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="finger" params="prefix parent offset limit">
    <link name="${prefix}finger"/>
    <joint name="${prefix}finger_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${prefix}finger"/>
      <origin xyz="${offset} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="${limit}" effort="10" velocity="1"/>
    </joint>
  </xacro:macro>
</robot>
