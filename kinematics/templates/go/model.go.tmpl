func (g *{{.TypeName}}) DoCommand(ctx context.Context, cmd map[string]interface{}) (map[string]interface{}, error) {
	return nil, errUnimplemented
}

func (g *{{.TypeName}}) Status(ctx context.Context) (map[string]interface{}, error) {
	return map[string]interface{}{}, nil
}

