{
	"name": "@viamrobotics/visualization",
	"version": "2.4.0",
	"description": "Motion visualization with Viam",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"vite dev\" \"go run cmd/draw-server/main.go -port ${DRAW_SERVICE_PORT:-3030}\"",
		"dev:https": "vite dev -- --https",
		"up": "wireit",
		"build": "wireit",
		"vite-build": "wireit",
		"build:workers": "wireit",
		"go-build": "wireit",
		"package": "wireit",
		"svelte-sync": "wireit",
		"prepare": "pnpm svelte-sync && pnpm build:workers || echo ''",
		"prepack": "wireit",
		"preview": "vite preview",
		"check": "wireit",
		"check:e2e": "wireit",
		"check:watch": "svelte-kit sync && pnpm build:workers && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write . && ./etc/eslint-progress.sh . --fix --concurrency auto",
		"lint": "wireit",
		"lint:prettier": "wireit",
		"lint:eslint": "wireit",
		"lint:draw": "wireit",
		"lint:client": "wireit",
		"lint:scenes": "wireit",
		"knip": "npx knip --include files,exports,types",
		"test": "wireit",
		"test:unit": "pnpm test:rdk-golden && vitest",
		"test:unit-run": "wireit",
		"test:coverage": "wireit",
		"test:client": "wireit",
		"test:draw": "wireit",
		"test:rdk-golden": "wireit",
		"e2e": "pnpm go-build && playwright test --project=drawing --project=matrix",
		"e2e:ui": "pnpm go-build && playwright test --project=drawing --project=matrix --ui",
		"e2e:matrix": "pnpm go-build && playwright test --project=matrix",
		"e2e:robot": "./e2e/setup.sh && playwright test --project=robot",
		"e2e:all": "pnpm e2e && pnpm e2e:robot",
		"vet": "wireit",
		"vet:draw": "wireit",
		"vet:client": "wireit",
		"vet:scenes": "wireit",
		"proto": "wireit",
		"proto:vendor": "wireit",
		"proto:dep-update": "buf dep update",
		"proto:gen-go": "wireit",
		"proto:gen-ts": "wireit",
		"proto:lint": "wireit",
		"proto:format": "buf format -w",
		"proto:format-check": "wireit",
		"proto:clean": "rm -rf src/lib/buf protos/vendor",
		"model-pipeline:run": "wireit",
		"release": "changeset publish",
		"docs:dev": "pnpm --dir docs dev",
		"docs:build": "pnpm --dir docs build",
		"docs:preview": "pnpm --dir docs preview"
	},
	"wireit": {
		"up": {
			"command": ".bin/draw-server -production -port ${DRAW_SERVICE_PORT:-3030} -static-port ${STATIC_PORT:-5173}",
			"dependencies": [
				"vite-build",
				"go-build"
			]
		},
		"build": {
			"dependencies": [
				"vite-build",
				"package"
			]
		},
		"vite-build": {
			"command": "vite build",
			"files": [
				"src/**",
				"static/**",
				"vite.config.ts",
				"svelte.config.js",
				"tsconfig.json",
				"tailwind.config.ts",
				"package.json"
			],
			"output": [
				"build/**",
				".svelte-kit/output/**"
			],
			"dependencies": [
				"proto:gen-ts",
				"svelte-sync",
				"build:workers"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			],
			"env": {
				"BASE_PATH": {
					"external": true
				},
				"DRAW_SERVICE_PORT": {
					"external": true
				},
				"STATIC_PORT": {
					"external": true
				},
				"VITE_CONFIGS": {
					"external": true
				}
			}
		},
		"build:workers": {
			"command": "node scripts/build-workers.js",
			"files": [
				"scripts/build-workers.js",
				"src/lib/loaders/pcd/worker.ts"
			],
			"output": [
				"src/lib/loaders/pcd/worker.inline.ts"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"go-build": {
			"command": "go build -o .bin/draw-server ./cmd/draw-server && go build -o .bin/draw-scenes ./e2e/fixtures/draw-scenes",
			"files": [
				"cmd/draw-server/**",
				"e2e/fixtures/draw-scenes/**",
				"client/**",
				"draw/**",
				"go.mod",
				"go.sum"
			],
			"output": [
				".bin/draw-server",
				".bin/draw-scenes"
			]
		},
		"package": {
			"command": "svelte-package && publint",
			"files": [
				"src/lib/**",
				"svelte.config.js",
				"tsconfig.json",
				"package.json"
			],
			"output": [
				"dist/**"
			],
			"dependencies": [
				"proto:gen-ts",
				"svelte-sync",
				"build:workers"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"svelte-sync": {
			"command": "svelte-kit sync",
			"files": [
				"svelte.config.js",
				"src/**",
				"tsconfig.json"
			],
			"output": [
				".svelte-kit/generated/**",
				".svelte-kit/types/**",
				".svelte-kit/ambient.d.ts",
				".svelte-kit/non-ambient.d.ts",
				".svelte-kit/env.d.ts",
				".svelte-kit/tsconfig.json"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"prepack": {
			"dependencies": [
				"package"
			]
		},
		"check": {
			"command": "svelte-check --tsconfig ./tsconfig.json",
			"files": [
				"src/**",
				"tsconfig.json",
				"svelte.config.js",
				"package.json"
			],
			"output": [],
			"dependencies": [
				"test:rdk-golden",
				"proto:gen-ts",
				"svelte-sync",
				"build:workers",
				"vet",
				"check:e2e"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"check:e2e": {
			"command": "tsc -p tsconfig.e2e.json",
			"files": [
				"e2e/**/*.ts",
				"playwright.config.ts",
				"playwright.playground.config.ts",
				"tsconfig.e2e.json",
				"tsconfig.json",
				"src/lib/buf/**"
			],
			"output": [],
			"dependencies": [
				"proto:gen-ts",
				"svelte-sync"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"lint": {
			"dependencies": [
				"lint:prettier",
				"lint:eslint",
				"lint:draw",
				"lint:scenes"
			]
		},
		"lint:prettier": {
			"command": "prettier --check .",
			"files": [
				"**",
				"!.bin/**",
				"!build/**",
				"!dist/**",
				"!.svelte-kit/**",
				"!.astro/**",
				"!.output/**",
				"!coverage/**",
				"!test-results/**",
				"!.tmp/**",
				"!src/lib/buf/**",
				"!protos/vendor/**",
				"!draw/v1/**",
				"!**/*.inline.ts",
				"!**/__snapshots__/**",
				"!**/*-snapshots/**",
				"!static/test-fixtures/**",
				"!static/Big_Buck_Bunny_4K.webm",
				"!e2e/.bin/**",
				"!docs/.astro/**",
				"!docs/dist/**",
				"!docs/node_modules/**",
				"!docs/public/playground/**",
				"!docs/src/content/docs/api/**",
				"!**/*.tgz"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"lint:eslint": {
			"command": "eslint . --concurrency auto",
			"files": [
				"**",
				"!.bin/**",
				"!build/**",
				"!dist/**",
				"!.svelte-kit/**",
				"!.astro/**",
				"!.output/**",
				"!coverage/**",
				"!test-results/**",
				"!.tmp/**",
				"!src/lib/buf/**",
				"!protos/vendor/**",
				"!draw/v1/**",
				"!**/*.inline.ts",
				"!**/__snapshots__/**",
				"!**/*-snapshots/**",
				"!static/test-fixtures/**",
				"!static/Big_Buck_Bunny_4K.webm",
				"!e2e/.bin/**",
				"!docs/.astro/**",
				"!docs/dist/**",
				"!docs/node_modules/**",
				"!docs/public/playground/**",
				"!docs/src/content/docs/api/**",
				"!**/*.tgz"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"lint:draw": {
			"command": "golangci-lint run --allow-parallel-runners ./draw/...",
			"files": [
				"draw/**",
				"go.mod",
				"go.sum",
				".golangci.yml"
			],
			"output": []
		},
		"lint:client": {
			"command": "golangci-lint run --allow-parallel-runners ./client/...",
			"files": [
				"client/**",
				"go.mod",
				"go.sum",
				".golangci.yml"
			],
			"output": []
		},
		"vet": {
			"dependencies": [
				"vet:draw",
				"vet:client",
				"vet:scenes"
			]
		},
		"vet:draw": {
			"command": "go vet ./draw/...",
			"files": [
				"draw/**",
				"go.mod",
				"go.sum"
			],
			"output": []
		},
		"vet:client": {
			"command": "go vet ./client/...",
			"files": [
				"client/**",
				"go.mod",
				"go.sum"
			],
			"output": []
		},
		"test": {
			"dependencies": [
				"test:unit-run"
			]
		},
		"test:unit-run": {
			"command": "vitest --run",
			"files": [
				"src/**",
				"vite.config.ts",
				"vitest-setup-client.ts",
				"tsconfig.json"
			],
			"output": [],
			"dependencies": [
				"test:rdk-golden",
				"proto:gen-ts"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"test:coverage": {
			"command": "vitest run --coverage",
			"files": [
				"src/**",
				"vite.config.ts",
				"vitest-setup-client.ts",
				"tsconfig.json"
			],
			"output": [
				"coverage/**"
			],
			"dependencies": [
				"test:rdk-golden",
				"proto:gen-ts"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"test:client": {
			"command": "go test ./client/... -count=1",
			"files": [
				"client/**",
				"go.mod",
				"go.sum"
			],
			"output": []
		},
		"test:draw": {
			"command": "go test ./draw/... -count=1",
			"files": [
				"draw/**",
				"go.mod",
				"go.sum"
			],
			"output": []
		},
		"test:rdk-golden": {
			"command": "cd src/lib/math/rdk-math && go test ./... -count=1",
			"files": [
				"src/lib/math/rdk-math/**",
				"!src/lib/math/rdk-math/testdata/**"
			],
			"output": [
				"src/lib/math/rdk-math/testdata/**"
			],
			"clean": true
		},
		"proto": {
			"command": "pnpm proto:dep-update && pnpm proto:format && pnpm proto:lint && pnpm proto:gen-go && pnpm proto:gen-ts",
			"dependencies": [
				"proto:vendor"
			]
		},
		"proto:vendor": {
			"command": "buf export buf.build/viamrobotics/api --output protos/vendor",
			"files": [
				"buf.yaml",
				"buf.lock"
			],
			"output": [
				"protos/vendor/**"
			]
		},
		"proto:gen-go": {
			"command": "PATH=\"$(go env GOPATH)/bin:$PATH\" buf generate --template buf.gen.go.yaml",
			"files": [
				"protos/draw/**",
				"protos/vendor/**",
				"buf.gen.go.yaml",
				"buf.yaml",
				"buf.lock"
			],
			"output": [],
			"dependencies": [
				"proto:vendor"
			]
		},
		"proto:gen-ts": {
			"command": "buf generate --template buf.gen.typescript.yaml",
			"files": [
				"protos/draw/**",
				"protos/vendor/**",
				"buf.gen.typescript.yaml",
				"buf.yaml",
				"buf.lock"
			],
			"output": [
				"src/lib/buf/**"
			],
			"clean": true,
			"dependencies": [
				"proto:vendor"
			]
		},
		"proto:lint": {
			"command": "buf lint",
			"files": [
				"protos/draw/**",
				"buf.yaml"
			],
			"output": []
		},
		"proto:format-check": {
			"command": "buf format --diff --exit-code",
			"files": [
				"protos/draw/**"
			],
			"output": []
		},
		"model-pipeline:run": {
			"command": "node scripts/model-pipeline.js",
			"files": [
				"scripts/model-pipeline.js",
				"static/models/*.glb",
				"static/models/*.gltf"
			],
			"output": [
				"src/lib/components/models/*.svelte"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"lint:scenes": {
			"command": "golangci-lint run --allow-parallel-runners ./e2e/fixtures/draw-scenes/...",
			"files": [
				"e2e/fixtures/draw-scenes/**",
				"client/**",
				"draw/**",
				"go.mod",
				"go.sum",
				".golangci.yml"
			],
			"output": []
		},
		"vet:scenes": {
			"command": "go vet ./e2e/fixtures/draw-scenes/...",
			"files": [
				"e2e/fixtures/draw-scenes/**",
				"client/**",
				"draw/**",
				"go.mod",
				"go.sum"
			],
			"output": []
		}
	},
	"devDependencies": {
