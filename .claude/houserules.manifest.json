        "script": "regen-on-edit.mjs"
      },
      {
        "event": "Stop",
        "matcher": null,
        "script": "changeset-check.mjs"
      },
      {
        "event": "Stop",
        "matcher": null,
        "script": "changeset-gate.mjs"
      }
    ],
    "permissions": [
