{
  "$schema": "../node_modules/@houserules/cli/schema/houserules.config.schema.json",
  "version": 2,
  "packageManager": "pnpm",
  "plugins": [
    {
      "name": "@houserules/plugin-prose",
      "alias": "prose"
    },
    {
      "name": "@houserules/plugin-typescript",
      "alias": "ts"
    },
    {
      "name": "@houserules/plugin-svelte",
      "alias": "svelte"
    },
    {
      "name": "@houserules/plugin-three",
      "alias": "three"
    },
    {
      "name": "@houserules/plugin-testing",
      "alias": "testing"
    },
    {
      "name": "@houserules/plugin-changesets",
      "alias": "changesets"
    },
    {
      "name": "@houserules/plugin-design",
      "alias": "design"
    },
    {
      "name": "@houserules/plugin-accessibility",
      "alias": "accessibility"
    }
  ],
  "fix": {
    "runner": "pnpm",
    "filterFlag": "",
    "runScriptPrefix": [
      "run"
    ],
    "commands": [
      "lint:fix",
      "format:fix"
    ],
    "onSubagentStop": false
  },
  "verify": {
    "runner": "pnpm",
    "filterFlag": "",
    "runScriptPrefix": [
      "run"
    ],
    "commands": [
      "verify"
    ]
  },
  "lintableExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "mjs",
    "cjs",
    "svelte",
    "md",
    "json",
    "css",
    "html"
  ],
  "generatedFilePattern": "/(?:CHANGELOG|BACKLOG)\\.md$",
  "guard": {
    "gitCommit": true,
    "gitPush": true,
    "gitStash": true,
    "prCreate": true,
    "custom": []
  },
  "changesets": {
    "enabled": true,
    "stopCheck": true,
    "baseBranch": "main"
  },
  "ledger": {
    "enabled": false
  },
  "targets": [
    {
      "name": "visualization",
      "prefix": "VISUALIZATION",
      "packageName": "@viamrobotics/visualization",
      "pathPrefix": "",
      "sourcePath": "src",
      "label": "Visualization",
      "regen": {
        "sourceGlob": "protos/draw/**",
        "command": "pnpm run proto:gen-go && pnpm run proto:gen-ts"
      },
      "fixCommands": [
        "format"
      ],
      "verifyCommands": [
        "check",
        "test",
        "lint"
      ]
    }
  ],
  "moduleOptions": {
    "svelte/svelte": [],
    "three/three": [
      "threlte"
    ],
    "testing/testing": [
      "typescript",
      "svelte",
      "3d"
    ],
    "accessibility/accessibility": [
      "html",
      "svelte"
    ]
  }
}
