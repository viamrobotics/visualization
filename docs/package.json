{
	"name": "@viamrobotics/visualization-docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "BASE_PATH=/visualization/playground pnpm build:app && pnpm gen:api && astro dev",
		"build": "pnpm gen:api && astro build",
		"build:app": "pnpm --dir .. exec vite build && rm -rf public/playground && rsync -a --exclude='models' ../build/ public/playground/",
		"gen:api": "node ./scripts/generate-api-docs.mjs"
	},
	"dependencies": {
		"@astrojs/starlight": "0.41.6",
		"@tailwindcss/vite": "4.2.4",
		"astro": "7.2.8",
		"sharp": "0.35.4",
		"starlight-theme-nova": "^0.12.2",
		"tailwindcss": "4.2.4"
	},
	"devDependencies": {
		"@fontsource-variable/public-sans": "^5.2.7",
		"@fontsource-variable/roboto-mono": "^5.2.8",
		"@viamrobotics/tailwind-config": "^1.2.0",
		"remark-gfm": "^4.0.1",
		"typescript": "5.9.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		]
	}
}
